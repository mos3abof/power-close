{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "power-close",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // power-close.com: the static site in website/, as it is (no build step).
  // Only this folder is uploaded, so the extension's source stays out of it.
  "assets": {
    "directory": "./website"
  },
  // Served at both; Cloudflare makes the DNS records and certificates.
  "routes": [
    { "pattern": "power-close.com", "custom_domain": true },
    { "pattern": "www.power-close.com", "custom_domain": true }
  ],
  "previews": {}
}
